# URL of the backend API. Copy to .env to override the default.
# Local:  http://localhost:5000/api
# Render: https://<your-backend>.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Clinic time zone for "today" and "has started" (same as the backend APP_TIMEZONE).
VITE_BUSINESS_TIMEZONE=Asia/Manila

# Clinic contact details shown in the site footer ("Visit us"). Leave any blank to hide it.
VITE_CLINIC_ADDRESS=
VITE_CLINIC_PHONE=
VITE_CLINIC_EMAIL=
VITE_CLINIC_HOURS=
